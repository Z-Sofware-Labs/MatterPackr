          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-iso9660-image.svg": "icons/linux/application-x-iso9660-image.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-cd-image.svg": "icons/linux/application-x-cd-image.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-raw-disk-image.svg": "icons/linux/application-x-raw-disk-image.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-xz.svg": "icons/linux/application-x-xz.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-xz-compressed-tar.svg": "icons/linux/application-x-xz-compressed-tar.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-zstd.svg": "icons/linux/application-zstd.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-zstd-compressed-tar.svg": "icons/linux/application-x-zstd-compressed-tar.svg",
