          "/usr/share/icons/hicolor/scalable/mimetypes/application-zip.svg": "icons/linux/application-zip.svg",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-zip.svg": "icons/linux/application-x-zip.svg",
