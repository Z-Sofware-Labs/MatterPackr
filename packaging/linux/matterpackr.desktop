[Desktop Entry]
Name=MatterPackr
Comment=Modern Multi-Threaded Archive Manager
Exec=MatterPackr %F
Icon=matterpackr
Terminal=false
Type=Application
Categories=Utility;Archiving;Compression;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/x-rar;application/x-rar-compressed;application/vnd.rar;application/x-tar;application/x-compressed-tar;application/x-gzip;application/gzip;application/x-bzip2;application/x-bzip-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-iso9660-image;application/x-raw-disk-image;application/vnd.ms-cab-compressed;application/x-cpio;application/x-archive;
