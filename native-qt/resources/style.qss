/* MatterPackr Fluent Dark Modern Theme - Compact Desktop Scale */
QMainWindow, QWidget#centralWidget {
    background-color: #16171c;
    color: #e5e7eb;
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, sans-serif;
}

/* Menu Bar - Compact 24px */
QMenuBar {
    background-color: #181920;
    color: #d1d5db;
    border-bottom: 1px solid #242632;
    padding: 1px 4px;
    font-size: 11.5px;
}
QMenuBar::item {
    background: transparent;
    padding: 3px 8px;
    border-radius: 4px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #2c2f3d;
    color: #ffffff;
}
QMenuBar::item:disabled {
    color: #8b949e;
    background-color: transparent;
}
QMenuBar::item:disabled:selected {
    color: #8b949e;
    background-color: transparent;
}

/* Menus */
QMenu {
    background-color: #1c1d25;
    color: #e5e7eb;
    border: 1px solid #2f3240;
    border-radius: 6px;
    padding: 3px;
    font-size: 11.5px;
}
QMenu::item {
    padding: 4px 20px 4px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #8b949e;
    background-color: transparent;
}
QMenu::item:disabled:selected {
    color: #8b949e;
    background-color: transparent;
}
QMenu::separator {
    height: 1px;
    background: #2b2d38;
    margin: 3px 4px;
}

/* Toolbar - Compact 48px */
QToolBar {
    background-color: #181920;
    border-top: none;
    border-bottom: 1px solid #242632;
    spacing: 1px;
    padding: 2px 4px;
}
QToolBar::separator {
    width: 1px;
    background-color: #2b2d38;
    margin: 5px 4px;
}

QToolButton {
    background: transparent;
    color: #d1d5db;
    font-size: 9.5px;
    font-weight: 500;
    border-radius: 4px;
    padding: 1px 2px;
    min-width: 48px;
    max-width: 60px;
    min-height: 44px;
    max-height: 52px;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}
QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.16);
    color: #ffffff;
}
QToolButton:disabled {
    color: #8b949e;
}

/* Table View */
QTableView {
    background-color: #121316;
    alternate-background-color: #16171d;
    color: #e5e7eb;
    border: none;
    gridline-color: transparent;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    font-size: 11.5px;
    outline: none;
}
QTableView::item {
    padding: 2px 6px;
    border: none;
}
QTableView::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

/* Table Header - Compact 24px */
QHeaderView::section {
    background-color: #181920;
    color: #9ca3af;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border: none;
    border-right: 1px solid #232530;
    border-bottom: 1px solid #232530;
    height: 24px;
}
QHeaderView::section:hover {
    background-color: #22242e;
    color: #ffffff;
}

/* ScrollBars */
QScrollBar:vertical {
    background: #14151a;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2d303d;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #474b5e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #14151a;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2d303d;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #474b5e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* Status Bar - Compact 22px */
QStatusBar {
    background-color: #121316;
    color: #9ca3af;
    border-top: 1px solid #20222a;
    padding: 1px 6px;
    font-size: 10px;
    min-height: 22px;
    max-height: 22px;
}
QStatusBar::item {
    border: none;
}

/* Dialogs & Windows */
QDialog {
    background-color: #181920;
    color: #e5e7eb;
}

/* Tab Widget & Tab Bar - Compact */
QTabWidget::pane {
    border: 1px solid #282a36;
    background-color: #1c1d25;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid transparent;
    border-bottom: none;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 500;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #1c1d25;
    color: #60a5fa;
    border: 1px solid #282a36;
    border-bottom: 1px solid #1c1d25;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #f3f4f6;
    background-color: rgba(255, 255, 255, 0.04);
}

/* Group Boxes - Compact */
QGroupBox {
    border: 1px solid #2b2d3a;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px 8px 6px 8px;
    background-color: rgba(255, 255, 255, 0.02);
    font-size: 10.5px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #e5e7eb;
    font-size: 10.5px;
    font-weight: 600;
}

QGroupBox#grpRW::title {
    color: #34d399;
    font-weight: bold;
}
QGroupBox#grpRO::title {
    color: #fbbf24;
    font-weight: bold;
}

/* Check Boxes */
QCheckBox {
    color: #d1d5db;
    font-size: 11px;
    spacing: 7px;
}
QCheckBox:hover {
    color: #ffffff;
}
QCheckBox:disabled {
    color: #8b949e;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}
QCheckBox::indicator:unchecked {
    image: url(:/checkbox-unchecked.svg);
}
QCheckBox::indicator:unchecked:hover {
    image: url(:/checkbox-unchecked-hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/checkbox-checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/checkbox-checked-hover.svg);
}

/* Radio Buttons */
QRadioButton {
    color: #e5e7eb;
    font-size: 11px;
    spacing: 8px;
    padding: 4px 6px;
    border-radius: 5px;
}
QRadioButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}
QRadioButton::indicator:unchecked {
    image: url(:/radio-unchecked.svg);
}
QRadioButton::indicator:unchecked:hover {
    image: url(:/radio-unchecked-hover.svg);
}
QRadioButton::indicator:checked {
    image: url(:/radio-checked.svg);
}

/* Push Buttons */
QPushButton {
    background-color: #262835;
    color: #e5e7eb;
    border: 1px solid #373a4c;
    border-radius: 5px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #313444;
    color: #ffffff;
    border-color: #4b516b;
}
QPushButton:pressed {
    background-color: #1d1e28;
}
QPushButton:default, QPushButton#btnPrimary {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
    font-weight: 600;
}
QPushButton:default:hover, QPushButton#btnPrimary:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

/* Combo Box & Spin Box */
QComboBox, QSpinBox {
    background-color: #16171d;
    color: #e5e7eb;
    border: 1px solid #2f3242;
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 11px;
    min-height: 22px;
}
QComboBox:hover, QSpinBox:hover {
    border-color: #3b82f6;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #1c1d25;
    color: #e5e7eb;
    border: 1px solid #2f3240;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    padding: 3px;
}

/* Navigation / Breadcrumb Bar */
#navBar {
    background-color: #1a1b24;
    border-bottom: 1px solid #282a38;
}
#navBar QLabel {
    color: #9ca3af;
    font-size: 11px;
}
#navBar QLabel b {
    color: #60a5fa;
}
#navBar QPushButton {
    background-color: #262837;
    color: #e5e7eb;
    border: 1px solid #373a4e;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 11px;
}
#navBar QPushButton:hover {
    background-color: #323549;
    border-color: #3b82f6;
    color: #ffffff;
}
#navBar QPushButton:disabled {
    color: #8b949e;
    border-color: #282a38;
    background-color: #181922;
}

/* Splitter */
QSplitter::handle {
    background-color: #242635;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* Explorer Folder Tree */
#treeHeader {
    background-color: #171821;
    border-bottom: 1px solid #262837;
    border-right: 1px solid #262837;
}
#treeHeader QLabel {
    color: #9ca3af;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#treeHeader QPushButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
}

#btnNavUp {
    padding: 0px;
}

#btnCloseTree {
    border: none;
    background-color: transparent;
    border-radius: 4px;
    padding: 0px;
}
#btnCloseTree:hover {
    background-color: rgba(239, 68, 68, 0.2);
}

QTreeWidget {
    background-color: #14151c;
    border: none;
    border-right: 1px solid #262837;
    color: #cbd5e1;
    font-size: 11px;
    padding: 4px;
}
QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
    margin: 1px 2px;
}
QTreeWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}
QTreeWidget::item:selected {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 500;
}

/* File Filter / Search Bar */
#filterBar {
    background-color: #1a1b24;
    border-bottom: 1px solid #282a38;
}
#filterBar QLineEdit {
    background-color: #232533;
    border: 1px solid #373a4e;
    border-radius: 4px;
    padding: 3px 8px;
    color: #f3f4f6;
    font-size: 11.5px;
}
#filterBar QLineEdit:focus {
    border-color: #3b82f6;
    background-color: #272a3a;
}
#btnCloseFilter {
    border: none;
    background-color: transparent;
    border-radius: 4px;
    padding: 0px;
}
#btnCloseFilter:hover {
    background-color: rgba(239, 68, 68, 0.25);
}
