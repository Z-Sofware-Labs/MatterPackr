<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>MatterPackr</string>
    <key>CFBundleIdentifier</key>
    <string>com.matterpackr.archiver</string>
    <key>CFBundleName</key>
    <string>MatterPackr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>3.0.10</string>
    <key>CFBundleVersion</key>
    <string>3.0.10</string>
    <key>CFBundleIconFile</key>
    <string>MatterPackr.icns</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- ZIP -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>ZIP Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>zip.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.zip-archive</string>
                <string>com.pkware.zip-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zip</string>
                <string>zipx</string>
            </array>
        </dict>
        <!-- 7Z -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>7-Zip Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>7z.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.7-zip.7-zip-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>7z</string>
            </array>
        </dict>
        <!-- TAR -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>TAR Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>tar.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.tar-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>tar</string>
            </array>
        </dict>
        <!-- GZIP & TGZ -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Gzip Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>tgz.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.gnu.gnu-zip-archive</string>
                <string>org.gnu.gnu-zip-tar-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>gz</string>
                <string>tgz</string>
                <string>tar.gz</string>
            </array>
        </dict>
        <!-- BZIP2 & TBZ -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Bzip2 Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>tbz2.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.bzip2-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>bz2</string>
                <string>tbz2</string>
                <string>tbz</string>
                <string>tar.bz2</string>
            </array>
        </dict>
        <!-- XZ & TXZ -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>XZ Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>txz.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.tukaani.xz-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>xz</string>
                <string>txz</string>
                <string>tar.xz</string>
            </array>
        </dict>
        <!-- RAR -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>RAR Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>rar.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.rarlab.rar-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>rar</string>
            </array>
        </dict>
        <!-- ISO -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>ISO Disc Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>iso.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.iso-image</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>iso</string>
            </array>
        </dict>
        <!-- CAB -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Cabinet Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>cab.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.microsoft.cab</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cab</string>
            </array>
        </dict>
        <!-- CPIO -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>CPIO Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>cpio.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cpio</string>
            </array>
        </dict>
        <!-- UNIX Archive (AR) -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>UNIX Archive</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>ar.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ar</string>
                <string>a</string>
            </array>
        </dict>
        <!-- Raw Disk Image -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Raw Disk Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>img.icns</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>img</string>
                <string>bin</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
